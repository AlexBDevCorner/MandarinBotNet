# Copy this file to .env.tools. The real file is ignored by Git.
# Do not commit real values.

# Optional: raises Context7 documentation lookup limits.
CONTEXT7_API_KEY=

# Fine-grained GitHub PAT scoped to this repository.
GITHUB_PAT_TOKEN=

# Optional CLI/app override. Normally leave empty so OCI MCP uses
# %USERPROFILE%/.oci/config and the project-pinned mandarinbot-agent profile.
OCI_CONFIG_FILE=
